{
    "name": "PornHub",
    "description": "Plugin de PornHub para Grayjay con búsqueda, canales, calidad, subtítulos y manejo defensivo de streams caducados.",
    "author": "Montana",
    "authorUrl": "",
    "platformUrl": "https://www.pornhub.com",
    "sourceUrl": "https://raw.githubusercontent.com/Montana2903/pluggin-PHub/main/PornhubConfig.json",
    "repositoryUrl": "https://github.com/Montana2903/pluggin-PHub",
    "scriptUrl": "./PornhubScript.js",
    "version": 30,
    "scriptPublicKey": "",
    "scriptSignature": "",
    "iconUrl": "./icon.jpg",
    "id": "dce06efc-862e-11ee-b9d1-0242ac120002",
    "packages": [
        "Http",
        "DOMParser"
    ],
    "allowAllHttpHeaderAccess": true,
    "allowUrls": [
        ".pornhub.com",
        ".phncdn.com"
    ],
    "playback": {
        "maxPageAttempts": 4,
        "maxProbeAttempts": 5,
        "probeInitialDelayMs": 1000,
        "probeBackoffMs": 500,
        "enableCacheBuster": true,
        "cacheBusterParam": "_",
        "preferredQualities": ["1080", "720", "480", "360", "240"]
    },
    "http": {
        "defaultRetries": 3,
        "requireTokenRetries": 3,
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:143.0) Gecko/20100101 Firefox/143.0",
        "cookie": "platform=pc; accessAgeDisclaimerPH=2"
    },
    "logging": {
        "level": "info",
        "enableFlashvarsDump": false
    },
    "behavior": {
        "refreshSessionOn401_403_410": true,
        "tryFallbackDefinitions": true,
        "reloadPlayerIfAllProbesFail": true
    }
}
